# Firebase email/password account that acts as the developer. Required for developer tools.
DEV_EMAIL=
DEV_PASSWORD=
# Required whenever DEV_EMAIL is set. Add it to the connector URL: https://<host>/mcp?key=<MCP_SECRET>
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MCP_SECRET=
# Optional (defaults match the code-req project)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
SITE_URL=https://code-req.web.app
# Local testing only: use the Firebase emulators instead of the real project
# FIREBASE_EMULATOR=1
