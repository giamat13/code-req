{
  "name": "code-req",
  "version": "0.1.0",
  "private": false,
  "description": "Ask a developer to build your app. Free, open source, and self-hostable.",
  "license": "MIT",
  "author": "giamat13",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giamat13/code-req.git"
  },
  "homepage": "https://giamat13.github.io/code-req/",
  "bugs": {
    "url": "https://github.com/giamat13/code-req/issues"
  },
  "scripts": {
    "config": "node scripts/write-config.mjs",
    "vendor": "node scripts/vendor.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,hosting --project demo-apprequest",
    "seed": "node scripts/seed-emulator.mjs",
    "reset": "node scripts/reset-emulator.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-apprequest \"node --test test/rules/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:ci": "firebase emulators:exec --only auth,firestore,hosting --project demo-apprequest \"playwright test\"",
    "check": "npm run lint && npm run format:check && npm run i18n:check && npm run test:unit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "dompurify": "3.4.17",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "firebase": "13.0.0",
    "firebase-tools": "15.34.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10"
  }
}
